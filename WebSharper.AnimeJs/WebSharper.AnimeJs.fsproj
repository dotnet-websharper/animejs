<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>netstandard2.0</TargetFrameworks>
        <WebSharperProject>binding</WebSharperProject>
        <WebSharperSourceMap>false</WebSharperSourceMap>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Product>WebSharper.AnimeJs 4.5.0+</Product>
        <Title>https://github.com/dotnet-websharper/animejs/</Title>
        <Company>IntelliFactory</Company>
        <Copyright>(c) 2023 IntelliFactory</Copyright>
    </PropertyGroup>
    <PropertyGroup>
        <NpmDependencies>
            <NpmPackage Name="animejs" Version="&gt;= 4.5.0 &lt; 5.0.0" ResolutionStrategy="Max" />
        </NpmDependencies>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="Main.fs" />
    </ItemGroup>
    <Import Project="..\paket-files\wsbuild\github.com\dotnet-websharper\build-script\WebSharper.Fake.targets" Condition="Exists('..\paket-files\wsbuild\github.com\dotnet-websharper\build-script\WebSharper.Fake.targets')" />
    <Import Project="..\.paket\Paket.Restore.targets" />
</Project>